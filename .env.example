# Copy to .env and change the values. Never commit .env.

NODE_ENV=development
PORT=4000

# Local Postgres from docker-compose.yml (these values are read by docker compose too)
POSTGRES_USER=galla
POSTGRES_PASSWORD=change-me
POSTGRES_DB=galla_mandi
POSTGRES_PORT=5432
DATABASE_URL=postgres://galla:change-me@localhost:5432/galla_mandi

# Comma-separated list of browser origins allowed to call the API (web, admin)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Auth. Generate secrets with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_ACCESS_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=7
# Only needed in production when web/admin and the API share a parent domain, e.g. .example.com
# COOKIE_DOMAIN=
# Shop panel address, used in staff invite links
WEB_APP_URL=http://localhost:3000
OTP_SECRET=change-me-to-another-random-string-of-32-chars
LOGIN_THROTTLE_LIMIT=5
LOGIN_THROTTLE_TTL_MS=60000

# Seed users for local development (npm run db:seed)
SEED_SUPER_ADMIN_PHONE=03000000001
SEED_SUPER_ADMIN_EMAIL=admin@gallamandi.local
SEED_SUPER_ADMIN_PASSWORD=change-me-admin
SEED_OWNER_PHONE=03000000002
SEED_OWNER_EMAIL=owner@demo-mandi.local
SEED_OWNER_PASSWORD=change-me-owner

# Rate limit: THROTTLE_LIMIT requests per THROTTLE_TTL_MS per client
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
