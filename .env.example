# Copy to .env and change the values. Never commit .env.

NODE_ENV=development
PORT=4000

# Local Postgres from docker-compose.yml (these values are read by docker compose too)
POSTGRES_USER=galla
POSTGRES_PASSWORD=change-me
POSTGRES_DB=galla_mandi
POSTGRES_PORT=5432
DATABASE_URL=postgres://galla:change-me@localhost:5432/galla_mandi

# Comma-separated list of browser origins allowed to call the API (web, admin)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate limit: THROTTLE_LIMIT requests per THROTTLE_TTL_MS per client
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
