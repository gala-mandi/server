{
  "name": "galla-mandi-server",
  "version": "0.0.1",
  "description": "Galla Mandi API (NestJS + PostgreSQL + Drizzle)",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "dev": "nest start --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky || true",
    "start": "node dist/main",
    "start:debug": "nest start --debug --watch",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "db:seed": "ts-node src/database/seed.ts",
    "load:seed": "ts-node load/seed.ts",
    "load:smoke": "docker run --rm -i --add-host=host.docker.internal:host-gateway -u \"$(id -u):$(id -g)\" -v \"$PWD/load:/load\" -e API_URL -e LOAD_TEST_PASSWORD -e LOAD_SHOPS -e LOAD_OPERATORS -e DURATION grafana/k6:2.3.0 run -e DURATION=1m /load/purchases.js",
    "load:test": "mkdir -p load/results && docker run --rm -i --add-host=host.docker.internal:host-gateway -u \"$(id -u):$(id -g)\" -v \"$PWD/load:/load\" -e API_URL -e LOAD_TEST_PASSWORD -e LOAD_SHOPS -e LOAD_OPERATORS -e DURATION grafana/k6:2.3.0 run --summary-export=/load/results/summary.json /load/purchases.js",
    "load:verify": "ts-node load/verify.ts",
    "load:isolation": "docker run --rm -i --add-host=host.docker.internal:host-gateway -u \"$(id -u):$(id -g)\" -v \"$PWD/load:/load\" -e API_URL -e LOAD_TEST_PASSWORD -e LOAD_SHOPS -e LOAD_OPERATORS -e DURATION grafana/k6:2.3.0 run /load/isolation.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^12.3.3",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "argon2": "^0.45.1",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.4",
    "helmet": "^8.3.0",
    "nestjs-cls": "^7.0.1",
    "nestjs-pino": "^5.3.1",
    "nestjs-zod": "^5.5.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^12.3.3",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "overrides": {
    "multer": "2.5.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.ts",
      "!database/migrations/**",
      "!main.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "engines": {
    "node": ">=22.12"
  },
  "lint-staged": {
    "*.{ts,mjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  }
}
