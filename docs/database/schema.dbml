// Galla Mandi — database schema (PostgreSQL)
// Paste this whole file into https://dbdiagram.io/d to see the ER diagram.
//
// This file is the single source of truth for the database design. The Drizzle
// schema in `server` (src/database/schema/*.ts) must match it table by table:
// table and column names, SQL types, NOT NULL, defaults, primary keys, unique
// columns, indexes, foreign keys, check constraints and enums. The server's
// unit tests fail when they differ (src/database/schema-dbml.spec.ts).
//
// Rules used everywhere:
// - Every business table has tenant_id (one tenant = one shop) + Row-Level Security
//   (policy `tenant_isolation` for the role `app_tenant`). Tables without RLS:
//   plans, tenants, users, refresh_tokens, otp_codes, auth_logs, audit_logs.
// - Base columns of a business table: id, tenant_id, created_by, created_at,
//   updated_at, deleted_at. updated_at is set by the API on every update.
// - Money: numeric(14,2). Weight: numeric(12,3) in kg. Never float.
// - Soft delete with deleted_at. Timestamps are timestamptz.
// - Unique rules are per shop, e.g. (tenant_id, phone); indexes start with tenant_id.
// - `ref: >?` = optional relation (the column may be NULL).

Project galla_mandi {
  database_type: 'PostgreSQL'
  Note: 'Multi-tenant mandi management system. Every shop owner gets one tenant.'
}

// ───────────────────────── Platform & tenants ─────────────────────────

Enum tenant_status {
  trial
  active
  suspended
  cancelled
}

Table plans {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(60) [not null, unique]
  max_users int [not null]
  max_branches int [not null, default: 1, note: 'Stored and shown; not enforced yet (no branches in the app)']
  price_monthly numeric(14,2) [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  Note: 'Platform table: no tenant_id, no RLS. Only the super-admin writes it; shops read it.'
}

Table tenants {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(120) [not null, note: 'Shop name']
  slug varchar(80) [not null, unique]
  owner_name varchar(120) [not null]
  phone varchar(20) [not null]
  email varchar(160)
  address text
  city varchar(80)
  logo_url text
  status tenant_status [not null, default: 'trial']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

Table tenant_subscriptions {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id]
  plan_id uuid [not null, ref: > plans.id]
  starts_on date [not null, note: 'Asia/Karachi date, included']
  ends_on date [not null, note: 'Asia/Karachi date, included']
  grace_days int [not null, default: 7]
  status varchar(20) [not null, note: 'active | expired | cancelled']
  created_at timestamptz [not null, default: `now()`]
  Note: '''
  A shop's plan for a period. The current one is the latest by ends_on that is not cancelled.
  Shops only read it (RLS); the super-admin and the daily job write it.
  '''
  indexes {
    (tenant_id, ends_on) [name: 'tenant_subscriptions_tenant_id_ends_on_idx']
  }
  checks {
    `status in ('active', 'expired', 'cancelled')` [name: 'tenant_subscriptions_status']
    `ends_on >= starts_on` [name: 'tenant_subscriptions_dates']
    `grace_days >= 0` [name: 'tenant_subscriptions_grace_days']
  }
}

Table tenant_settings {
  tenant_id uuid [pk, ref: - tenants.id]
  display_name varchar(120)
  parchi_footer text
  default_commission_pct numeric(5,2) [not null, default: 0]
  market_fee_pct numeric(5,2) [not null, default: 0]
  labour_per_bag numeric(14,2) [not null, default: 0]
  default_unit varchar(10) [not null, default: 'kg', note: 'kg | maund | bag']
  maund_kg numeric(6,3) [not null, default: 40]
  bill_prefix varchar(10)
  financial_year_start date
  language varchar(5) [not null, default: 'en', note: 'en | ur']
  credit_limit_action varchar(10) [not null, default: 'warn', note: 'Sale over the buyer credit limit: warn | block']
  overpayment_action varchar(10) [not null, default: 'advance', note: 'Payment over the khata balance: advance (rest is peshgi) | block']
  updated_at timestamptz [not null, default: `now()`]
  Note: 'One row per shop, created with the shop.'
}

// ───────────────────────── Users & auth ─────────────────────────

Enum user_role {
  super_admin
  owner
  manager
  operator
}

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [ref: >? tenants.id, note: 'NULL only for super_admin']
  name varchar(120) [not null]
  phone varchar(20) [not null, unique]
  email varchar(160) [unique]
  password_hash text [not null, note: 'argon2']
  role user_role [not null]
  is_active boolean [not null, default: true]
  must_change_password boolean [not null, default: false]
  last_login_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  indexes {
    (tenant_id, role) [name: 'users_tenant_id_role_idx']
  }
}

Table refresh_tokens {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  token_hash text [not null, unique]
  family_id uuid [not null, note: 'Rotation family — reuse revokes the whole family']
  device_info varchar(200)
  ip inet
  expires_at timestamptz [not null]
  revoked_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  indexes {
    user_id [name: 'refresh_tokens_user_id_idx']
  }
}

Table otp_codes {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  purpose varchar(20) [not null, note: 'reset_password | verify_phone']
  code_hash text [not null]
  channel varchar(10) [not null, note: 'whatsapp | sms']
  attempts int [not null, default: 0]
  expires_at timestamptz [not null]
  used_at timestamptz
  created_at timestamptz [not null, default: `now()`]
}

Table invitations {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id]
  phone varchar(20) [not null]
  role user_role [not null]
  token_hash text [not null, unique, note: 'SHA-256 of the link token; the token is never stored']
  invited_by uuid [not null, ref: > users.id]
  expires_at timestamptz [not null]
  accepted_at timestamptz
  cancelled_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  Note: 'A staff invite: single use, expires after 48 hours.'
  indexes {
    (tenant_id, created_at) [name: 'invitations_tenant_id_created_at_idx']
  }
}

Table auth_logs {
  id bigserial [pk]
  user_id uuid [ref: >? users.id]
  tenant_id uuid [ref: >? tenants.id]
  action varchar(20) [not null, note: 'login | logout | failed | refresh | locked | reset']
  ip inet
  user_agent text
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, created_at) [name: 'auth_logs_tenant_id_created_at_idx']
  }
}

Table audit_logs {
  id bigserial [pk]
  tenant_id uuid [ref: >? tenants.id]
  user_id uuid [ref: >? users.id]
  entity varchar(40) [not null]
  entity_id uuid [not null]
  action varchar(10) [not null, note: 'create | update | delete | restore | access (super-admin entering a shop) | remind (plan-ending reminder)']
  before jsonb
  after jsonb
  ip inet
  user_agent text
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, entity, entity_id) [name: 'audit_logs_tenant_id_entity_entity_id_idx']
    (tenant_id, created_at) [name: 'audit_logs_tenant_id_created_at_idx']
  }
}

// ───────────────────────── Masters ─────────────────────────

Enum trader_type {
  kissan
  beopari
  arhti
}

Table traders {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id]
  type trader_type [not null]
  name varchar(120) [not null]
  father_name varchar(120)
  phone varchar(20)
  cnic varchar(15)
  village varchar(80)
  address text
  opening_balance numeric(14,2) [not null, default: 0]
  opening_balance_type varchar(6) [not null, default: 'debit', note: 'debit | credit']
  credit_limit numeric(14,2)
  is_active boolean [not null, default: true]
  notes text
  created_by uuid [ref: >? users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  indexes {
    (tenant_id, phone) [unique, name: 'traders_tenant_id_phone_key', note: 'NULL phones do not collide']
    (tenant_id, type) [name: 'traders_tenant_id_type_idx']
    `name gin_trgm_ops` [type: gin, name: 'traders_name_trgm_idx', note: 'Name search (pg_trgm)']
  }
}

Table commodities {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id]
  name varchar(80) [not null]
  name_ur varchar(80)
  category varchar(40)
  default_unit varchar(10) [not null, default: 'maund', note: 'kg | maund | bag']
  bag_weight_kg numeric(8,3)
  commission_pct numeric(5,2) [note: 'Overrides the shop default when set']
  market_fee_pct numeric(5,2)
  labour_per_bag numeric(14,2)
  is_active boolean [not null, default: true]
  created_by uuid [ref: >? users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  indexes {
    (tenant_id, name) [unique, name: 'commodities_tenant_id_name_key']
  }
}

Table daily_rates {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id]
  commodity_id uuid [not null, ref: > commodities.id]
  rate_date date [not null, note: 'Asia/Karachi date']
  min_rate numeric(14,2) [not null]
  max_rate numeric(14,2) [not null]
  avg_rate numeric(14,2)
  rate_unit varchar(10) [not null, default: 'maund', note: 'maund | kg']
  created_by uuid [ref: >? users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  indexes {
    (tenant_id, commodity_id, rate_date) [unique, name: 'daily_rates_tenant_id_commodity_id_rate_date_key']
    (tenant_id, rate_date) [name: 'daily_rates_tenant_id_rate_date_idx']
  }
}

Table number_sequences {
  tenant_id uuid [not null, ref: > tenants.id]
  doc_type varchar(20) [not null, note: 'purchase | sale | payment | receipt']
  financial_year varchar(9) [not null, note: 'e.g. 2026-27']
  prefix varchar(10)
  next_number int [not null, default: 1]
  Note: 'One bill-number counter per shop, document type and financial year; locked while a number is taken.'
  indexes {
    (tenant_id, doc_type, financial_year) [pk]
  }
}

// ───────────────────────── Purchases & sales ─────────────────────────

Enum doc_status {
  draft
  posted
  cancelled
}

Table purchases {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id]
  bill_no varchar(30) [not null, note: 'e.g. PUR-2026-27-000123, from number_sequences']
  trader_id uuid [not null, ref: > traders.id, note: 'Kissan (seller)']
  purchase_date date [not null, note: 'Asia/Karachi date']
  gross_amount numeric(14,2) [not null]
  total_deductions numeric(14,2) [not null, default: 0]
  net_amount numeric(14,2) [not null]
  paid_amount numeric(14,2) [not null, default: 0, note: 'Paid to the kissan on the same save']
  status doc_status [not null, default: 'posted']
  notes text
  idempotency_key varchar(64)
  created_by uuid [ref: >? users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  indexes {
    (tenant_id, bill_no) [unique, name: 'purchases_tenant_id_bill_no_key']
    (tenant_id, purchase_date) [name: 'purchases_tenant_id_purchase_date_idx']
    (tenant_id, trader_id) [name: 'purchases_tenant_id_trader_id_idx']
    (tenant_id, idempotency_key) [unique, name: 'purchases_tenant_id_idempotency_key_key']
  }
}

Table purchase_items {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id]
  purchase_id uuid [not null, ref: > purchases.id]
  commodity_id uuid [not null, ref: > commodities.id]
  bags int
  weight_kg numeric(12,3) [not null]
  rate numeric(14,2) [not null, note: 'Copied at save time']
  rate_unit varchar(10) [not null, note: 'kg | maund | bag']
  amount numeric(14,2) [not null]
  created_by uuid [ref: >? users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  indexes {
    (tenant_id, purchase_id) [name: 'purchase_items_tenant_id_purchase_id_idx']
    (tenant_id, commodity_id) [name: 'purchase_items_tenant_id_commodity_id_idx']
  }
}

Table purchase_charges {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id]
  purchase_id uuid [not null, ref: > purchases.id]
  type varchar(20) [not null, note: 'commission | market_fee | labour | other']
  basis varchar(10) [not null, note: 'percent | per_bag | fixed']
  value numeric(14,2) [not null, note: 'The rate copied at save time: % for percent, Rs per bag, or Rs for fixed']
  amount numeric(14,2) [not null]
  created_by uuid [ref: >? users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  indexes {
    (tenant_id, purchase_id) [name: 'purchase_charges_tenant_id_purchase_id_idx']
  }
}

Table sales {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id]
  bill_no varchar(30) [not null, note: 'e.g. SAL-2026-27-000123, from number_sequences']
  buyer_id uuid [not null, ref: > traders.id, note: 'Beopari (buyer)']
  sale_date date [not null, note: 'Asia/Karachi date']
  gross_amount numeric(14,2) [not null]
  total_charges numeric(14,2) [not null, default: 0]
  net_amount numeric(14,2) [not null]
  received_amount numeric(14,2) [not null, default: 0, note: 'Received from the beopari on the same save']
  status doc_status [not null, default: 'posted']
  notes text
  idempotency_key varchar(64)
  created_by uuid [ref: >? users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  indexes {
    (tenant_id, bill_no) [unique, name: 'sales_tenant_id_bill_no_key']
    (tenant_id, sale_date) [name: 'sales_tenant_id_sale_date_idx']
    (tenant_id, buyer_id) [name: 'sales_tenant_id_buyer_id_idx']
    (tenant_id, idempotency_key) [unique, name: 'sales_tenant_id_idempotency_key_key']
  }
}

Table sale_items {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id]
  sale_id uuid [not null, ref: > sales.id]
  commodity_id uuid [not null, ref: > commodities.id]
  purchase_item_id uuid [ref: >? purchase_items.id, note: 'Optional: which farmer lot was sold']
  bags int
  weight_kg numeric(12,3) [not null]
  rate numeric(14,2) [not null, note: 'Copied at save time']
  rate_unit varchar(10) [not null, note: 'kg | maund | bag']
  amount numeric(14,2) [not null]
  created_by uuid [ref: >? users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  indexes {
    (tenant_id, sale_id) [name: 'sale_items_tenant_id_sale_id_idx']
    (tenant_id, commodity_id) [name: 'sale_items_tenant_id_commodity_id_idx']
    (tenant_id, purchase_item_id) [name: 'sale_items_tenant_id_purchase_item_id_idx']
  }
}

Table sale_charges {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id]
  sale_id uuid [not null, ref: > sales.id]
  type varchar(20) [not null, note: 'commission | market_fee | labour | other']
  basis varchar(10) [not null, note: 'percent | per_bag | fixed']
  value numeric(14,2) [not null, note: 'The rate copied at save time: % for percent, Rs per bag, or Rs for fixed']
  amount numeric(14,2) [not null]
  created_by uuid [ref: >? users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  indexes {
    (tenant_id, sale_id) [name: 'sale_charges_tenant_id_sale_id_idx']
  }
}

// ───────────────────────── Ledger & payments ─────────────────────────

Table ledger_entries {
  id bigserial [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  trader_id uuid [not null, ref: > traders.id]
  entry_date date [not null]
  source_type varchar(20) [not null, note: 'opening | purchase | sale | payment | receipt | adjustment | reversal']
  source_id uuid [note: 'id of the purchase / sale / payment that created it']
  debit numeric(14,2) [not null, default: 0]
  credit numeric(14,2) [not null, default: 0]
  narration text
  created_by uuid [ref: >? users.id]
  created_at timestamptz [not null, default: `now()`]
  Note: '''
  Append-only: the app role may not UPDATE or DELETE rows; a mistake is corrected with a reversal entry.
  Balances are summed from entries (with ledger_daily_balances), never stored and edited.
  '''
  indexes {
    (tenant_id, trader_id, entry_date) [name: 'ledger_entries_tenant_id_trader_id_entry_date_idx']
    (tenant_id, source_type, source_id) [name: 'ledger_entries_tenant_id_source_type_source_id_idx']
  }
}

Table ledger_daily_balances {
  tenant_id uuid [not null, ref: > tenants.id]
  trader_id uuid [not null, ref: > traders.id]
  entry_date date [not null]
  debit numeric(14,2) [not null, default: 0]
  credit numeric(14,2) [not null, default: 0]
  Note: '''
  Daily snapshot of each trader's debit and credit totals, kept by the trigger
  ledger_entries_daily_balances (AFTER INSERT on ledger_entries) in the same transaction.
  Never written by the API (read-only for the app role). A balance on a date is the sum of the days up to it.
  '''
  indexes {
    (tenant_id, trader_id, entry_date) [pk]
  }
}

Table payments {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id]
  voucher_no varchar(30) [not null, note: 'e.g. PAY-2026-27-000123 (paid) or RCT-2026-27-000123 (received)']
  direction varchar(10) [not null, note: 'paid (to kissan) | received (from beopari)']
  trader_id uuid [not null, ref: > traders.id]
  payment_date date [not null, note: 'Asia/Karachi date']
  amount numeric(14,2) [not null]
  method varchar(10) [not null, note: 'cash | bank | cheque | online']
  reference varchar(80)
  notes text
  status doc_status [not null, default: 'posted']
  idempotency_key varchar(64)
  created_by uuid [ref: >? users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  Note: 'The part of amount that no payment_allocations row covers is an advance (peshgi).'
  indexes {
    (tenant_id, direction, voucher_no) [unique, name: 'payments_tenant_id_direction_voucher_no_key', note: 'Payments and receipts are two series']
    (tenant_id, payment_date) [name: 'payments_tenant_id_payment_date_idx']
    (tenant_id, trader_id) [name: 'payments_tenant_id_trader_id_idx']
    (tenant_id, idempotency_key) [unique, name: 'payments_tenant_id_idempotency_key_key']
  }
}

Table payment_allocations {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id]
  payment_id uuid [not null, ref: > payments.id]
  purchase_id uuid [ref: >? purchases.id]
  sale_id uuid [ref: >? sales.id]
  amount numeric(14,2) [not null]
  created_by uuid [ref: >? users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  Note: 'Exactly one of purchase_id / sale_id is set. Rows of a cancelled payment stay as history and no longer count.'
  indexes {
    (tenant_id, payment_id) [name: 'payment_allocations_tenant_id_payment_id_idx']
    (tenant_id, purchase_id) [name: 'payment_allocations_tenant_id_purchase_id_idx']
    (tenant_id, sale_id) [name: 'payment_allocations_tenant_id_sale_id_idx']
  }
  checks {
    `(purchase_id is null) <> (sale_id is null)` [name: 'payment_allocations_one_bill']
    `amount > 0` [name: 'payment_allocations_amount_positive']
  }
}
